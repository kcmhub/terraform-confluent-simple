{
  "type": "record",
  "name": "OrderCreated",
  "namespace": "io.kcmhub.examples.orders",
  "doc": "A customer placed an order.",
  "fields": [
    { "name": "orderId", "type": "string" },
    { "name": "customerId", "type": "string" },
    { "name": "amountMinor", "type": "long", "doc": "Total amount in minor units (cents)." },
    { "name": "currency", "type": "string", "doc": "ISO 4217 currency code." },
    { "name": "createdAt", "type": { "type": "long", "logicalType": "timestamp-millis" } }
  ]
}
